<!--
  Password reset email, sent after POST /api/password_reset/.
  Context: email, reset_url
  Compile with `npm run build:emails`, never edit html/password_reset.html by hand.
-->
<mjml lang="en">
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-preview>Use this link to set a new Videoflix password.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>

  <mj-body>
    <mj-section padding="32px 0 0">
      <mj-column>
        <mj-text>Hello,</mj-text>

        <mj-text>
          We recently received a request to reset your password. If you made this
          request, please click on the following link to reset your password:
        </mj-text>

        <mj-button href="{{ reset_url }}">Reset password</mj-button>

        <mj-text>
          Please note that for security reasons, this link is only valid for 24 hours.
        </mj-text>

        <mj-text>
          If you did not request a password reset, please ignore this email.
        </mj-text>

        <mj-text>Best regards,</mj-text>

        <mj-text padding="0 24px 24px">Your Videoflix team!</mj-text>

        <mj-image
          src="cid:videoflix-logo"
          alt="Videoflix"
          width="251px"
          height="40px"
          align="left"
          padding="0 24px 32px"
        />

        <mj-divider border-width="1px" border-color="#e5e5e5" padding="0 24px 16px" />

        <mj-text css-class="fallback-link" font-size="13px" line-height="20px" color="#757575">
          If the button does not work, copy this link into your browser:<br />
          <a href="{{ reset_url }}">{{ reset_url }}</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
